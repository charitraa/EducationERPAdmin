# Base URL of the EducationERP backend's v1 API.
# Leave unset in development: the app calls /api/v1 and Vite proxies it to
# API_PROXY_TARGET (default http://localhost:8000).
# VITE_API_BASE_URL=https://erp.example.com/api/v1

# Contact address shown in the public site's footer and legal pages.
# VITE_CONTACT_EMAIL=hello@example.com

# Public address of this site, used for search engines (canonical link,
# share image, sitemap.xml). Leave unset for local development.
# VITE_SITE_URL=https://erp.example.com
