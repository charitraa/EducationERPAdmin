# Base URL of the EducationERP backend's v1 API.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Dummy-data mode: every lib/api/* module serves an in-memory seed dataset
# (src/mocks/) instead of calling the backend, and the app auto-signs-in as
# a mock superuser so every page and permission gate is visible with zero
# setup. Defaults to true (on) when unset. Set to false once the real
# backend above is running and you want to exercise it for real.
VITE_USE_MOCKS=true
